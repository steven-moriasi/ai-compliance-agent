COMPLIANCE_DATABASE_URL=postgresql+psycopg://compliance:compliance@postgres:5432/compliance
COMPLIANCE_ENVIRONMENT=development
COMPLIANCE_AUTH_MODE=development
COMPLIANCE_MODEL_PROVIDER=deterministic
COMPLIANCE_CONFIDENCE_THRESHOLD=0.7
COMPLIANCE_ANALYSIS_LEASE_SECONDS=120
COMPLIANCE_ANALYSIS_MAX_ATTEMPTS=3
COMPLIANCE_NOTIFICATION_WEBHOOK_URL=https://notifications.example.test/compliance
COMPLIANCE_NOTIFICATION_WEBHOOK_SECRET=replace-with-a-managed-secret
